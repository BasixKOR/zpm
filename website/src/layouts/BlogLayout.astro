---
import BaseLayout from './BaseLayout.astro';
import '../styles/theme.css';
import '../styles/blog.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} variant="docs" activePage="blog">
  <slot />

  <footer class="border-t border-[var(--line)] mt-16 py-10">
    <div class="max-w-[1400px] mx-auto px-7 flex items-center justify-between flex-wrap gap-4 text-[13px] text-[var(--fg-mute)]">
      <div>&copy; 2026 The Yarn Authors &middot; <a href="https://github.com/yarnpkg/zpm/blob/main/LICENSE" class="text-[var(--fg-dim)] hover:text-[var(--fg)] no-underline">BSD-2-Clause</a></div>
      <div class="flex gap-5">
        <a href="https://bsky.app/profile/yarnpkg.dev" class="text-[var(--fg-dim)] hover:text-[var(--fg)] no-underline">BlueSky</a>
        <a href="https://github.com/yarnpkg/zpm" class="text-[var(--fg-dim)] hover:text-[var(--fg)] no-underline">GitHub</a>
        <a href="https://discord.gg/yarnpkg" class="text-[var(--fg-dim)] hover:text-[var(--fg)] no-underline">Discord</a>
      </div>
    </div>
  </footer>

  <script is:inline src="/docs/docs.js"></script>
  <script is:inline src="/blog/blog.js"></script>
</BaseLayout>
