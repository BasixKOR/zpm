---
import DocsLayout from './DocsLayout.astro';
import ConceptSidebar from '../components/ConceptSidebar.astro';
import ReferenceSidebar from '../components/ReferenceSidebar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PrevNextNav from '../components/PrevNextNav.astro';

const { frontmatter } = Astro.props;
const breadcrumb = Array.isArray(frontmatter.breadcrumb)
  ? frontmatter.breadcrumb
  : ['Docs', frontmatter.breadcrumb];
---

<DocsLayout title={frontmatter.title} activePage={frontmatter.activePage} mainMaxWidth={frontmatter.mainMaxWidth}>
  <Fragment slot="sidebar">
    {frontmatter.sidebar === 'reference'
      ? <ReferenceSidebar activePage={frontmatter.sidebarActivePage || frontmatter.activePage} />
      : <ConceptSidebar activePage={frontmatter.activePage} />
    }
  </Fragment>

  <Breadcrumb segments={breadcrumb} />

  <slot />

  <PrevNextNav prev={frontmatter.prev} next={frontmatter.next} />
</DocsLayout>
