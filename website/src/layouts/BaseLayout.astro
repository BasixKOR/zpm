---
import Nav from '../components/Nav.astro';
import '../styles/tailwind.css';

interface Props {
  title: string;
  variant?: 'index' | 'docs';
  activePage?: string;
}

const { title, variant = 'index', activePage } = Astro.props;
const isDocs = variant === 'docs';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script is:inline>
  (function(){var t=localStorage.getItem('yarn-theme');if(t)document.documentElement.setAttribute('data-theme',t)})();
</script>
<slot name="head" />
</head>
<body class="m-0 p-0 overflow-x-hidden antialiased">

<div class="sky fixed inset-0 z-0"></div>
<canvas class="stars-canvas fixed inset-0 z-[1] pointer-events-none" id="stars"></canvas>
{isDocs && (
  <div class="fixed inset-0 z-[2] pointer-events-none bg-[color-mix(in_oklch,var(--bg-0)_35%,transparent)]"></div>
)}

<div class="relative z-[3]">
  <Nav variant={variant} activePage={activePage} />
  <slot />
</div>

</body>
</html>
