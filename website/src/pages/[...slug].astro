---
import { getCollection, render } from 'astro:content';
import MarkdownDocsLayout from '../layouts/MarkdownDocsLayout.astro';
import { getGroupLabelForSlug } from '../components/sidebar';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(doc => ({
    params: {slug: doc.data.slug},
    props: {doc},
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const groupLabel = getGroupLabelForSlug(doc.data.slug);

const frontmatter = {
  title: doc.data.title,
  description: doc.data.description,
  activePage: doc.data.slug,
  sidebar: doc.data.category === 'reference' ? 'reference' : 'concept',
  breadcrumb: groupLabel ? ['Docs', groupLabel, doc.data.title] : ['Docs', doc.data.title],
};
---

<MarkdownDocsLayout frontmatter={frontmatter}>
  <Content />
</MarkdownDocsLayout>
