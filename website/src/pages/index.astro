const state = { ...TWEAK_DEFAULTS };
const _savedTheme = localStorage.getItem('yarn-theme');
if (_savedTheme) state.theme = _savedTheme;
if (state.starDensity > 100) state.starDensity = Math.min(100, Math.round(state.starDensity / 4));
function motionToRad(m) { return (m / 100) * 0.08; }
state.starSpeed = motionToRad(state.starMotion);

function applyTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  localStorage.setItem('yarn-theme', t);
  document.getElementById('tw-dark').classList.toggle('on', t === 'dark');
  state.theme = t;
  if (typeof initStars === 'function' && W && H) initStars();
}
function applyAccent(h) {
  document.documentElement.style.setProperty('--accent-h', h);
  state.accentHue = h;
  document.querySelectorAll('#tw-accent .swatch').forEach(s => {
    s.classList.toggle('active', +s.dataset.h === +h);
  });
}
applyTheme(state.theme);
applyAccent(state.accentHue);

document.getElementById('theme-toggle').addEventListener('click', () => {
  applyTheme(state.theme === 'dark' ? 'light' : 'dark');
});

const copyBtn = document.getElementById('copy-btn');
const copyLabel = document.getElementById('copy-label');
copyBtn.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText('corepack enable && yarn init -2');
    copyBtn.classList.add('copied');
    copyLabel.textContent = 'Copied';
    setTimeout(() => { copyBtn.classList.remove('copied'); copyLabel.textContent = 'Copy'; }, 1400);
  } catch (e) {
    copyLabel.textContent = 'Ctrl+C';
  }
});

const TIPS = [
  'Yarn\'s <span class="mono">Plug\'n\'Play</span> install mode skips <span class="mono">node_modules</span> entirely — a single <span class="mono">.pnp.cjs</span> file resolves every module at runtime.',
  'A cold install on a 400-package monorepo drops from <strong class="text-[var(--fg)] font-medium">48.4s</strong> with npm to <strong class="text-[var(--fg)] font-medium">14.2s</strong> with Yarn 4 — thanks to parallel fetch and content-addressable caching.',
  'The <span class="mono">yarn.lock</span> format is deterministic and diff-friendly: reordering never changes the file, and conflicts are resolvable by hand.',
  '<span class="mono">yarn workspaces foreach</span> runs scripts across every package in topological order — no extra tooling, no Lerna, no glue.',
  'Zero-install repos commit the offline mirror so <span class="mono">git clone</span> is enough to start coding — no install step, no CI warm-up.',
  'Every release since 2.0 has been a native ESM binary distributed via <span class="mono">corepack</span> — no global install, version pinned per-project.',
];
const tipBody = document.getElementById('tip-body');
const tipCount = document.getElementById('tip-count');
const tipDots = document.getElementById('tip-dots');
TIPS.forEach((_, i) => {
  const d = document.createElement('span');
  d.className = 'tip-dot w-[5px] h-[5px] rounded-full bg-[var(--line-strong)] transition-all cursor-pointer' + (i === 0 ? ' active' : '');
  d.addEventListener('click', () => setTip(i));
  tipDots.appendChild(d);
});
let tipIdx = 0;
let tipTimer = null;
function pad(n) { return n < 10 ? '0' + n : '' + n; }
function renderTip() {
  tipBody.classList.add('fading');
  setTimeout(() => {
    tipBody.innerHTML = TIPS[tipIdx];
    tipCount.textContent = `${pad(tipIdx + 1)} / ${pad(TIPS.length)}`;
    tipDots.querySelectorAll('.tip-dot').forEach((d, i) => d.classList.toggle('active', i === tipIdx));
    tipBody.classList.remove('fading');
  }, 180);
}
function setTip(i) {
  tipIdx = ((i % TIPS.length) + TIPS.length) % TIPS.length;
  renderTip();
  restartTimer();
}
function restartTimer() {
  if (tipTimer) clearInterval(tipTimer);
  tipTimer = setInterval(() => setTip(tipIdx + 1), 7000);
}
document.getElementById('tip-prev').addEventListener('click', () => setTip(tipIdx - 1));
document.getElementById('tip-next').addEventListener('click', () => setTip(tipIdx + 1));
tipBody.innerHTML = TIPS[0];
tipCount.textContent = `01 / ${pad(TIPS.length)}`;
restartTimer();

/* ─────────────────── Starfield canvas ─────────────────── */
const canvas = document.getElementById('stars');
const ctx = canvas.getContext('2d');
var stars = [];
var constellationStars = [];
var constellations = [];
var shootingStars = [];
var catPath = null;
var W = window.innerWidth, H = window.innerHeight, DPR = 1;

function resize() {
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth;
  H = window.innerHeight;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  canvas.style.width = W + 'px';
  canvas.style.height = H + 'px';
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  computeCatPath();
  initStars();
}

let catImg = null;
let catImgReady = false;
let catRect = null;

(function loadCat() {
  const im = new Image();
  im.crossOrigin = 'anonymous';
  im.onload = () => { catImg = im; catImgReady = true; computeCatPath(); };
  im.src = 'cat.png';
})();

function computeCatPath() {
  const el = document.getElementById('cat-img');
  if (!el) { catRect = null; return; }
  const rect = el.getBoundingClientRect();
  if (catImg) {
    const iw = catImg.naturalWidth, ih = catImg.naturalHeight;
    const scale = Math.min(rect.width / iw, rect.height / ih);
    const dw = iw * scale, dh = ih * scale;
    const dx = rect.left + (rect.width - dw) / 2;
    const dy = rect.top + (rect.height - dh) / 2;
    catRect = { x: dx, y: dy, w: dw, h: dh };
  } else {
    catRect = { x: rect.left, y: rect.top, w: rect.width, h: rect.height };
  }
}

const CONSTELLATION_LIBRARY = (() => {
  const compile = (name, strokes) => {
    const stars = [];
    const edges = [];
    const EPS = 0.02;
    const findOrAdd = ([x, y]) => {
      for (let i = 0; i < stars.length; i++) {
        const [sx, sy] = stars[i];
        if (Math.abs(sx - x) < EPS && Math.abs(sy - y) < EPS) return i;
      }
      stars.push([x, y]);
      return stars.length - 1;
    };
    for (const stroke of strokes) {
      const idxs = stroke.map(findOrAdd);
      for (let i = 1; i < idxs.length; i++) {
        if (idxs[i - 1] !== idxs[i]) edges.push([idxs[i - 1], idxs[i]]);
      }
    }
    return { name, stars, edges };
  };
  const L = 0.15, R = 0.85, T = 0.10, B = 0.90, M = 0.50, MY = 0.50;
  const runes = [
    compile('fehu', [[[L,T],[L,B]], [[L,0.25],[R,0.10]], [[L,0.45],[R,0.30]]]),
    compile('uruz', [[[L,B],[L,T],[R,0.30],[R,B]]]),
    compile('thurisaz', [[[L,T],[L,B]], [[L,0.30],[R,MY],[L,0.70]]]),
    compile('ansuz', [[[L,T],[L,B]], [[L,0.22],[R,0.08]], [[L,0.40],[0.60,0.30]]]),
    compile('raidho', [[[L,T],[L,B]], [[L,T],[R,0.30],[L,MY]], [[L,MY],[R,B]]]),
    compile('kenaz', [[[L,T],[R,MY],[L,B]]]),
    compile('gebo', [[[L,T],[R,B]], [[R,T],[L,B]]]),
    compile('wunjo', [[[L,T],[L,B]], [[L,T],[R,0.25],[L,MY]]]),
    compile('hagalaz', [[[L,T],[L,B]], [[R,T],[R,B]], [[L,MY],[R,MY]]]),
    compile('nauthiz', [[[L,T],[L,B]], [[L,0.30],[R,0.70]]]),
    compile('isa', [[[M,T],[M,B]]]),
    compile('jera', [[[L,0.30],[0.40,T],[M,0.30]], [[M,0.70],[0.60,B],[R,0.70]]]),
    compile('eihwaz', [[[L,0.25],[M,T]], [[M,T],[M,B]], [[M,B],[R,0.75]]]),
    compile('perthro', [[[R,T],[L,T],[L,B],[R,B]]]),
    compile('algiz', [[[M,B],[M,MY]], [[M,MY],[L,T]], [[M,MY],[R,T]]]),
    compile('sowilo', [[[R,T],[0.40,0.30],[0.60,0.70],[L,B]]]),
    compile('tiwaz', [[[M,T],[M,B]], [[L,0.30],[M,T],[R,0.30]]]),
    compile('berkano', [[[L,T],[L,B]], [[L,T],[R,0.28],[L,MY]], [[L,MY],[R,0.72],[L,B]]]),
    compile('ehwaz', [[[L,B],[L,T]], [[L,T],[R,B]], [[R,B],[R,T]], [[L,0.30],[R,0.30]]]),
    compile('mannaz', [[[L,B],[L,T]], [[R,B],[R,T]], [[L,T],[R,B]], [[R,T],[L,B]]]),
    compile('laguz', [[[L,T],[L,B]], [[L,T],[0.55,0.25]]]),
    compile('ingwaz', [[[M,T],[R,MY],[M,B],[L,MY],[M,T]]]),
    compile('dagaz', [[[L,T],[L,B]], [[R,T],[R,B]], [[L,T],[R,B]], [[L,B],[R,T]]]),
    compile('othala', [[[M,T],[R,0.35],[0.65,0.65],[M,MY],[0.35,0.65],[L,0.35],[M,T]], [[0.35,0.65],[0.25,B]], [[0.65,0.65],[0.75,B]]]),
  ];
  const extensions = [
    compile('ear', [[[M,T],[M,B]], [[L,0.25],[M,T],[R,0.25]], [[L,0.50],[M,0.30]]]),
    compile('cweorth', [[[M,B],[L,T]], [[M,B],[M,T]], [[M,B],[R,T]]]),
    compile('calc', [[[M,T],[M,MY]], [[M,MY],[L,B]], [[M,MY],[R,B]]]),
    compile('stan', [[[L,B],[L,0.30],[M,T],[R,0.30],[R,B]], [[L,0.30],[R,0.30]]]),
    compile('gar', [[[M,T],[M,B]], [[L,MY],[R,MY]], [[L,T],[R,B]], [[R,T],[L,B]]]),
    compile('yr', [[[M,T],[M,B]], [[L,B],[M,MY],[R,B]]]),
    compile('hagall', [[[M,T],[M,B]], [[L,0.25],[R,0.75]], [[R,0.25],[L,0.75]]]),
    compile('bind-gebo-isa', [[[L,T],[R,B]], [[R,T],[L,B]], [[M,T],[M,B]]]),
    compile('bind-tiwaz-stack', [[[M,T],[M,B]], [[0.30,0.20],[M,0.10],[0.70,0.20]], [[0.30,0.60],[M,MY],[0.70,0.60]]]),
    compile('bind-algiz-isa', [[[M,T],[M,B]], [[L,T],[M,0.35],[R,T]]]),
    compile('bind-fehu-2', [[[L,T],[L,B]], [[L,0.22],[M,0.10]], [[L,0.40],[0.55,0.30]], [[R,T],[R,B]], [[R,0.22],[0.70,0.10]]]),
    compile('bind-othala', [[[M,T],[R,MY],[M,B],[L,MY],[M,T]], [[L,MY],[0.05,0.80]], [[R,MY],[0.95,0.80]]]),
    compile('bind-ehwaz-rot', [[[L,T],[L,B]], [[R,T],[R,B]], [[L,T],[R,B]], [[L,0.30],[R,0.30]], [[L,0.70],[R,0.70]]]),
    compile('aegishjalmr', [[[M,T],[M,B]], [[L,MY],[R,MY]], [[0.25,0.25],[0.75,0.75]], [[0.75,0.25],[0.25,0.75]]]),
    compile('valknut', [[[M,T],[L,B],[R,B],[M,T]], [[0.35,0.40],[M,B]]]),
    compile('vegvisir', [[[M,T],[M,B]], [[L,MY],[R,MY]], [[M,0.20],[0.40,0.10]], [[M,0.20],[0.60,0.10]], [[M,0.80],[0.40,0.90]], [[M,0.80],[0.60,0.90]]]),
  ];
  let seed = 0xbeefcafe;
  const rnd = () => { seed = (seed * 1664525 + 1013904223) | 0; return ((seed >>> 0) % 1e6) / 1e6; };
  const pick = (arr) => arr[Math.floor(rnd() * arr.length)];
  const makeStroke = (kind) => {
    switch (kind) {
      case 'stave': return [[M, T], [M, B]];
      case 'hstave': return [[L, MY], [R, MY]];
      case 'slash-dr': return [[L, T], [R, B]];
      case 'slash-ur': return [[L, B], [R, T]];
      case 'chevron-r': return [[L, T], [R, MY], [L, B]];
      case 'chevron-l': return [[R, T], [L, MY], [R, B]];
      case 'chevron-u': return [[L, B], [M, T], [R, B]];
      case 'chevron-d': return [[L, T], [M, B], [R, T]];
      case 'top-arm-r': return [[M, T], [0.70 + rnd() * 0.15, 0.25 + rnd() * 0.1]];
      case 'top-arm-l': return [[M, T], [0.30 - rnd() * 0.15, 0.25 + rnd() * 0.1]];
      case 'bot-arm-r': return [[M, B], [0.70 + rnd() * 0.15, 0.75 - rnd() * 0.1]];
      case 'bot-arm-l': return [[M, B], [0.30 - rnd() * 0.15, 0.75 - rnd() * 0.1]];
      case 'side-arm': { const y = 0.30 + rnd() * 0.4; return [[L, y], [M, 0.25 + rnd() * 0.5]]; }
      case 'diamond-s': return [[M, 0.30], [0.62, MY], [M, 0.70], [0.38, MY], [M, 0.30]];
      case 'triangle-r': return [[L, 0.30], [R, MY], [L, 0.70]];
      case 'triangle-l': return [[R, 0.30], [L, MY], [R, 0.70]];
      case 'half-x': return [[L, 0.30], [R, 0.70]];
      case 'half-x2': return [[L, 0.70], [R, 0.30]];
    }
    return [[M, T], [M, B]];
  };
  const strokeKinds = ['stave','hstave','slash-dr','slash-ur','chevron-r','chevron-l','chevron-u','chevron-d','top-arm-r','top-arm-l','bot-arm-r','bot-arm-l','side-arm','diamond-s','triangle-r','triangle-l','half-x','half-x2'];
  const combined = [...runes, ...extensions];
  const needed = 80 - combined.length;
  for (let i = 0; i < needed; i++) {
    const count = 2 + Math.floor(rnd() * 2);
    const strokes = [];
    const used = new Set();
    for (let j = 0; j < count; j++) {
      let k = pick(strokeKinds);
      let guard = 0;
      while (used.has(k) && guard++ < 4) k = pick(strokeKinds);
      used.add(k);
      strokes.push(makeStroke(k));
    }
    if (rnd() < 0.55 && !used.has('stave')) strokes.unshift(makeStroke('stave'));
    combined.push(compile('bindrune-' + i, strokes));
  }
  return combined.slice(0, 80);
})();

function initStars() {
  const density = state.starDensity;
  const targetOnScreen = (density / 100) * 2700;
  const base = targetOnScreen * 3.0;
  const count = Math.max(0, Math.round(base * (W * H) / (1920 * 1080)));
  stars = [];
  for (let i = 0; i < count; i++) {
    const u = Math.random(), v = Math.random();
    const theta = 2 * Math.PI * u;
    const phi = Math.acos(2 * v - 1);
    stars.push({ theta, phi, r: Math.random()*1.2+0.25, baseAlpha: Math.random()*0.6+0.3, twinklePhase: Math.random()*Math.PI*2, twinkleSpeed: Math.random()*0.8+0.3 });
  }
  constellations = [];
  constellationStars = [];
  const MIN_ANGLE = 0.42;
  const MIN_COS = Math.cos(MIN_ANGLE);
  const anchors = [];
  const MAX_ATTEMPTS = 4000;
  let attempts = 0;
  while (anchors.length < 40 && attempts++ < MAX_ATTEMPTS) {
    const u = Math.random(), v = Math.random();
    const theta0 = 2 * Math.PI * u;
    const phi0 = Math.acos(2 * v - 1);
    const ok = anchors.every(a => {
      const dot = Math.sin(phi0)*Math.sin(a.phi)*Math.cos(theta0-a.theta) + Math.cos(phi0)*Math.cos(a.phi);
      return dot < MIN_COS;
    });
    if (ok) anchors.push({ theta: theta0, phi: phi0 });
  }
  const shuffled = CONSTELLATION_LIBRARY.slice().sort(() => Math.random() - 0.5);
  for (let idx = 0; idx < anchors.length && idx < shuffled.length; idx++) {
    const anchor = anchors[idx];
    const pattern = shuffled[idx];
    const sP = Math.sin(anchor.phi), cP = Math.cos(anchor.phi);
    const sT = Math.sin(anchor.theta), cT = Math.cos(anchor.theta);
    const ex = { x: -sT, y: 0, z: cT };
    const ey = { x: cP*cT, y: -sP, z: cP*sT };
    const n = { x: sP*cT, y: cP, z: sP*sT };
    const sizeRad = 0.14 + Math.random() * 0.08;
    const rot = Math.random() * Math.PI * 2;
    const nodes = pattern.stars.map(([nx, ny]) => {
      const lx = (nx - 0.5) * 2 * sizeRad + (Math.random() - 0.5) * 0.008;
      const ly = (ny - 0.5) * 2 * sizeRad + (Math.random() - 0.5) * 0.008;
      const rx = lx*Math.cos(rot) - ly*Math.sin(rot);
      const ry = lx*Math.sin(rot) + ly*Math.cos(rot);
      const px = n.x + rx*ex.x + ry*ey.x;
      const py = n.y + rx*ex.y + ry*ey.y;
      const pz = n.z + rx*ex.z + ry*ey.z;
      const mag = Math.hypot(px, py, pz);
      const ux = px/mag, uy = py/mag, uz = pz/mag;
      const phi = Math.acos(Math.max(-1, Math.min(1, uy)));
      const theta = Math.atan2(uz, ux);
      const star = { theta, phi, r: 1.4+Math.random()*0.6, baseAlpha: 0.9+Math.random()*0.1, twinklePhase: Math.random()*Math.PI*2, twinkleSpeed: 0.6+Math.random()*0.5, isConstellation: true };
      stars.push(star);
      constellationStars.push(star);
      return star;
    });
    for (const [a, b] of pattern.edges) constellations.push([nodes[a], nodes[b]]);
  }
}

function spawnShootingStar() {
  const startX = Math.random() * W * 0.6;
  const startY = Math.random() * 300 + 40;
  const angle = Math.PI / 4 + (Math.random() - 0.5) * 0.3;
  const speed = 8 + Math.random() * 4;
  shootingStars.push({ x: startX, y: startY, vx: Math.cos(angle)*speed, vy: Math.sin(angle)*speed, life: 0, maxLife: 60+Math.random()*30, trail: [] });
}

let t = 0;
let lastShoot = 0;
let lastFrameTs = 0;
let rotationAngle = 0;
const ROT_AXIS = (() => { const v = { x: 0.25, y: 0.92, z: 0.30 }; const m = Math.hypot(v.x, v.y, v.z); return { x: v.x/m, y: v.y/m, z: v.z/m }; })();
function rotateAroundAxis(x, y, z, axis, ang) {
  const c = Math.cos(ang), s = Math.sin(ang);
  const { x: ux, y: uy, z: uz } = axis;
  const dot = ux*x + uy*y + uz*z;
  return { x: x*c+(uy*z-uz*y)*s+ux*dot*(1-c), y: y*c+(uz*x-ux*z)*s+uy*dot*(1-c), z: z*c+(ux*y-uy*x)*s+uz*dot*(1-c) };
}

function tick(ts) {
  const dt = lastFrameTs ? Math.min(0.05, (ts - lastFrameTs) / 1000) : 0;
  lastFrameTs = ts;
  t = ts * 0.001;
  rotationAngle += (state.starSpeed || 0) * dt;
  ctx.clearRect(0, 0, W, H);
  const isDark = state.theme === 'dark';
  const starColor = isDark ? '255, 255, 255' : '255, 200, 100';
  const conColor = isDark ? '200, 210, 255' : '12, 16, 48';
  ctx.save();
  const opacityMul = Math.max(0, Math.min(1, (state.starOpacity ?? 100) / 100));
  const cx = W/2, cy = H/2;
  const projScale = Math.hypot(W, H) * 0.55;
  for (const s of stars) {
    const sinPhi = Math.sin(s.phi);
    const bx = sinPhi * Math.cos(s.theta);
    const by = Math.cos(s.phi);
    const bz = sinPhi * Math.sin(s.theta);
    const p = rotateAroundAxis(bx, by, bz, ROT_AXIS, rotationAngle);
    s._visible = (p.z >= -0.1);
    s._sx = cx + p.x * projScale;
    s._sy = cy + p.y * projScale;
    s._depth = p.z;
    if (!s._visible) continue;
    if (s._sx < -40 || s._sx > W+40 || s._sy < -40 || s._sy > H+40) continue;
    const depthFade = Math.min(1, Math.max(0, (p.z + 0.1) / 0.4));
    const tw = 0.6 + 0.4 * Math.sin(t * s.twinkleSpeed + s.twinklePhase);
    const a = s.baseAlpha * tw * depthFade * opacityMul;
    if (a <= 0.01) continue;
    ctx.beginPath();
    ctx.arc(s._sx, s._sy, s.r, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${starColor}, ${a.toFixed(3)})`;
    ctx.fill();
    if (s.r > 1.0) {
      ctx.beginPath();
      ctx.arc(s._sx, s._sy, s.r * 3, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${starColor}, ${(a * 0.12).toFixed(3)})`;
      ctx.fill();
    }
  }
  if (state.constellations) {
    ctx.strokeStyle = `rgba(${conColor}, ${isDark ? 0.18 : 0.12})`;
    ctx.lineWidth = 0.6;
    for (const [a, b] of constellations) {
      if (!a._visible || !b._visible) continue;
      const minDepth = Math.min(a._depth, b._depth);
      const fade = Math.min(1, Math.max(0, (minDepth + 0.1) / 0.4));
      if (fade <= 0.02) continue;
      ctx.globalAlpha = fade * opacityMul;
      ctx.beginPath();
      ctx.moveTo(a._sx, a._sy);
      ctx.lineTo(b._sx, b._sy);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }
  if (ts - lastShoot > 5000 + Math.random() * 6000 && isDark) { spawnShootingStar(); lastShoot = ts; }
  shootingStars = shootingStars.filter(ss => {
    ss.x += ss.vx; ss.y += ss.vy; ss.life++;
    ss.trail.push({ x: ss.x, y: ss.y });
    if (ss.trail.length > 18) ss.trail.shift();
    const alpha = 1 - (ss.life / ss.maxLife);
    for (let i = 0; i < ss.trail.length; i++) {
      const p = ss.trail[i];
      const ta = (i / ss.trail.length) * alpha;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.2 * (i / ss.trail.length), 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 240, 200, ${ta.toFixed(3)})`;
      ctx.fill();
    }
    ctx.beginPath();
    ctx.arc(ss.x, ss.y, 1.6, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(255, 250, 230, ${alpha.toFixed(3)})`;
    ctx.fill();
    return ss.life < ss.maxLife;
  });
  if (catImgReady && catRect) {
    ctx.globalCompositeOperation = 'destination-out';
    ctx.drawImage(catImg, catRect.x, catRect.y, catRect.w, catRect.h);
    ctx.globalCompositeOperation = 'source-over';
  }
  ctx.restore();
  requestAnimationFrame(tick);
}

window.addEventListener('resize', resize);
window.addEventListener('scroll', () => { computeCatPath(); }, { passive: true });
window.addEventListener('load', () => { setTimeout(() => { computeCatPath(); }, 200); });
resize();
requestAnimationFrame(tick);

/* ─────────────────── Perf chart bars ─────────────────── */
const chartData = [
  { name: 'yarn 4.8', value: 14.2, self: true },
  { name: 'competitor a', value: 22.8, self: false },
  { name: 'competitor b', value: 31.6, self: false },
  { name: 'competitor c', value: 48.4, self: false },
];
const maxVal = Math.max(...chartData.map(d => d.value));
const chart = document.getElementById('chart');
chartData.forEach((d, i) => {
  const pct = (d.value / maxVal) * 100;
  const row = document.createElement('div');
  row.className = 'grid grid-cols-[120px_1fr_70px] gap-5 items-center';
  row.innerHTML = `
    <div class="bar-label ${d.self ? 'self' : ''} text-[13px] text-[var(--fg-dim)] mono">${d.name}</div>
    <div class="h-7 bg-[var(--card)] border border-[var(--card-border)] rounded-md overflow-hidden relative">
      <div class="bar-fill ${d.self ? 'self' : ''} h-full rounded-[5px] bg-[var(--fg-dim)]" style="width:${pct.toFixed(1)}%; animation-delay: ${i * 120}ms;"></div>
    </div>
    <div class="bar-value ${d.self ? 'self' : ''} mono text-[13px] text-[var(--fg-dim)] text-right tabular-nums">${d.value.toFixed(1)}s</div>
  `;
  chart.appendChild(row);
});

/* ─────────────────── Tweaks wiring ─────────────────── */
const tweaksEl = document.getElementById('tweaks');
function persist(edits) {
  Object.assign(state, edits);
  try { window.parent.postMessage({ type: '__edit_mode_set_keys', edits: mapStateToKeys() }, '*'); } catch (e) {}
}
function mapStateToKeys() {
  return { theme: state.theme, starDensity: state.starDensity, starMotion: state.starMotion, starOpacity: state.starOpacity, constellations: state.constellations, accentHue: state.accentHue };
}
document.getElementById('tw-density').value = state.starDensity;
document.getElementById('tw-speed').value = state.starMotion;
document.getElementById('tw-opacity').value = state.starOpacity ?? 100;
document.getElementById('tw-constellation').classList.toggle('on', !!state.constellations);
document.getElementById('tw-dark').addEventListener('click', () => {
  const next = state.theme === 'dark' ? 'light' : 'dark';
  applyTheme(next);
  persist({ theme: next });
});
document.getElementById('tw-density').addEventListener('input', (e) => { state.starDensity = +e.target.value; initStars(); });
document.getElementById('tw-density').addEventListener('change', (e) => { persist({ starDensity: +e.target.value }); });
document.getElementById('tw-speed').addEventListener('input', (e) => { state.starMotion = +e.target.value; state.starSpeed = motionToRad(state.starMotion); });
document.getElementById('tw-speed').addEventListener('change', (e) => { persist({ starMotion: +e.target.value }); });
document.getElementById('tw-opacity').addEventListener('input', (e) => { state.starOpacity = +e.target.value; });
document.getElementById('tw-opacity').addEventListener('change', (e) => { persist({ starOpacity: +e.target.value }); });
document.getElementById('tw-constellation').addEventListener('click', (e) => {
  const on = !state.constellations;
  state.constellations = on;
  e.currentTarget.classList.toggle('on', on);
  persist({ constellations: on });
});
document.querySelectorAll('#tw-accent .swatch').forEach(sw => {
  sw.addEventListener('click', () => {
    const h = +sw.dataset.h;
    applyAccent(h);
    persist({ accentHue: h });
  });
});
document.getElementById('tweaks-close').addEventListener('click', () => {
  tweaksEl.classList.remove('open');
  try { window.parent.postMessage({ type: '__deactivate_edit_mode_requested' }, '*'); } catch(e){}
});
window.addEventListener('message', (e) => {
  const msg = e.data || {};
  if (msg.type === '__activate_edit_mode') tweaksEl.classList.add('open');
  if (msg.type === '__deactivate_edit_mode') tweaksEl.classList.remove('open');
});
try { window.parent.postMessage({ type: '__edit_mode_available' }, '*'); } catch(e){}
document.fonts && document.fonts.ready && document.fonts.ready.then(() => { computeCatPath(); });
</script>

