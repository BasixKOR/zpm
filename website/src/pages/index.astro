---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Yarn — the modern JavaScript package manager">
<style is:global slot="head">
:root {
  --accent-h: 38;
  --accent: oklch(0.78 0.16 var(--accent-h));
  --accent-soft: oklch(0.78 0.16 var(--accent-h) / 0.14);
  --accent-line: oklch(0.78 0.16 var(--accent-h) / 0.35);

  /* dark (default) */
  --bg-0: #05060f;
  --bg-1: #0a0e28;
  --bg-2: #141552;
  --bg-3: #2a1a6e;
  --fg: #e8ecff;
  --fg-dim: #a8b0d4;
  --fg-mute: #6872a0;
  --line: rgba(168, 176, 212, 0.14);
  --line-strong: rgba(168, 176, 212, 0.28);
  --card: rgba(12, 16, 44, 0.55);
  --card-border: rgba(120, 130, 180, 0.18);
  --cat-fill: #05060f;
  --star: #ffffff;
  --constellation: rgba(200, 210, 255, 0.35);
}

html[data-theme="light"] {
  --bg-0: #eef3ff;
  --bg-1: #dce7fb;
  --bg-2: #c5d5f2;
  --bg-3: #f0e4cf;
  --fg: #0c1030;
  --fg-dim: #3a4370;
  --fg-mute: #7a84a8;
  --line: rgba(12, 16, 48, 0.10);
  --line-strong: rgba(12, 16, 48, 0.22);
  --card: rgba(255, 255, 255, 0.55);
  --card-border: rgba(12, 16, 48, 0.08);
  --cat-fill: #0c1030;
  --star: #ffd98a;
  --constellation: rgba(12, 16, 48, 0.18);
}

body {
  font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
  background: var(--bg-0);
  color: var(--fg);
  transition: background 0.6s ease, color 0.6s ease;
}

.mono, code, pre { font-family: 'JetBrains Mono', ui-monospace, monospace; }

/* ── Sky background (complex multi-radial gradient kept in CSS) ── */
.sky {
  background:
    radial-gradient(ellipse 60% 35% at 78% 18%, oklch(0.42 0.18 290 / 0.45) 0%, transparent 60%),
    radial-gradient(ellipse 80% 40% at 20% 92%, oklch(0.38 0.14 220 / 0.35) 0%, transparent 55%),
    radial-gradient(ellipse 55% 45% at 8% 55%, oklch(0.40 0.14 235 / 0.30) 0%, transparent 60%),
    radial-gradient(ellipse 100% 70% at 50% 30%, oklch(0.28 0.12 270) 0%, transparent 65%),
    radial-gradient(ellipse 120% 100% at 50% 50%, transparent 40%, oklch(0.10 0.04 265 / 0.55) 100%),
    linear-gradient(180deg in oklch,
      oklch(0.12 0.05 265) 0%,
      oklch(0.18 0.09 270) 22%,
      oklch(0.22 0.11 275) 48%,
      oklch(0.16 0.08 272) 78%,
      oklch(0.09 0.04 265) 100%);
  transition: background 0.6s ease;
}
.sky::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.06;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5 0 0 0 0 0.5 0 0 0 0 0.5 0 0 0 1 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
}
html[data-theme="light"] .sky {
  background:
    radial-gradient(ellipse 50% 35% at 82% 12%, oklch(0.97 0.06 85 / 0.85) 0%, transparent 55%),
    radial-gradient(ellipse 110% 35% at 50% 98%, oklch(0.92 0.08 65) 0%, transparent 60%),
    radial-gradient(ellipse 80% 50% at 20% 40%, oklch(0.95 0.04 240 / 0.6) 0%, transparent 60%),
    radial-gradient(ellipse 140% 100% at 50% 50%, transparent 55%, oklch(0.75 0.06 240 / 0.25) 100%),
    linear-gradient(180deg in oklch,
      oklch(0.96 0.03 240) 0%,
      oklch(0.92 0.05 240) 35%,
      oklch(0.88 0.06 230) 65%,
      oklch(0.92 0.06 70) 100%);
}

/* Install-box atmospheric glow (pseudo-element) */
.install-glow::before {
  content: '';
  position: absolute;
  inset: -120px -80px -120px -260px;
  z-index: -1;
  pointer-events: none;
  background: radial-gradient(ellipse 60% 45% at 38% 50%,
    oklch(0.32 0.14 235 / 0.75) 0%,
    oklch(0.22 0.10 245 / 0.45) 40%,
    transparent 72%);
  filter: blur(10px);
}
html[data-theme="light"] .install-glow::before {
  background: radial-gradient(ellipse 60% 45% at 38% 50%,
    oklch(0.72 0.12 60 / 0.70) 0%,
    oklch(0.80 0.08 70 / 0.40) 40%,
    transparent 72%);
}

/* Cat light-mode filter */
html[data-theme="light"] img.cat { filter: brightness(0.15); }

/* Tip body crossfade */
#tip-body { transition: opacity 0.22s ease; }
#tip-body.fading { opacity: 0; }

/* Perf bar animation */
@keyframes grow { to { transform: scaleX(1); } }
.bar-fill {
  transform-origin: left;
  transform: scaleX(0);
  animation: grow 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* State classes that JS toggles — minimal rules */
#copy-btn.copied { color: var(--accent); border-color: var(--accent-line); }
.toggle::after {
  content: '';
  position: absolute;
  top: 2px; left: 2px;
  width: 18px; height: 18px;
  border-radius: 50%;
  background: var(--fg);
  transition: transform 0.2s;
}
.toggle.on { background: var(--accent); }
.toggle.on::after { transform: translateX(16px); background: var(--bg-0); }
.swatch.active { border-color: var(--fg); }
.tip-dot.active { background: var(--accent); transform: scale(1.25); }
.bar-fill.self { background: var(--accent) !important; }
.bar-label.self { color: var(--fg) !important; font-weight: 500; }
.bar-value.self { color: var(--accent) !important; font-weight: 500; }
.tweaks { display: none; }
.tweaks.open { display: block; }

/* Scoped media query for nav-links hide on small (easier than inline tailwind for JS-managed elements) */
@media (max-width: 960px) {
  .hide-on-md-narrow { display: none !important; }
}
</style>

  <!-- Hero -->
  <section class="relative min-h-[calc(100vh-67px)] px-8 py-[clamp(48px,8vh,120px)] flex items-center justify-center">
    <div class="max-w-[1240px] w-full mx-auto relative">
      <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-16 md:gap-20 items-center">
        <div>
          <div class="flex gap-2 flex-wrap mb-7">
            <span title="Stable" class="inline-flex items-center gap-2 pl-1 pr-2.5 py-1 border border-[var(--line-strong)] rounded-full text-[11.5px] text-[var(--fg-mute)] tracking-[0.02em]">
              <span class="mono px-2 py-0.5 rounded-full bg-[var(--accent-soft)] text-[var(--accent)] text-[10.5px] tracking-[0.08em] uppercase">stable</span>
              <span class="mono text-[var(--fg)]">v4.8.1</span>
            </span>
            <span title="Release candidate" class="inline-flex items-center gap-2 pl-1 pr-2.5 py-1 border border-[var(--line-strong)] rounded-full text-[11.5px] text-[var(--fg-mute)] tracking-[0.02em]">
              <span class="mono px-2 py-0.5 rounded-full bg-[color-mix(in_oklch,var(--fg-dim)_18%,transparent)] text-[var(--fg-dim)] text-[10.5px] tracking-[0.08em] uppercase">rc</span>
              <span class="mono text-[var(--fg)]">v5.0.0-rc.2</span>
            </span>
          </div>
          <h1 class="text-[clamp(48px,6.4vw,92px)] leading-[0.96] tracking-[-0.035em] font-medium m-0 mb-7 text-balance">
            Pulls its<br/>
            <em class="not-italic text-[var(--fg-dim)] font-light">weight.</em>
          </h1>
          <p class="text-[19px] leading-[1.55] text-[var(--fg-dim)] max-w-[540px] m-0 mb-10 text-pretty">
            Deterministic, offline-first package management for JavaScript. Built for monorepos.
          </p>

          <div class="flex gap-3 items-center flex-wrap mb-12">
            <a href="#" class="inline-flex items-center gap-2 px-[22px] py-[13px] rounded-[10px] text-[14.5px] font-medium no-underline border border-transparent cursor-pointer transition-all bg-[var(--fg)] text-[var(--bg-0)] hover:-translate-y-px">
              Get started
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M3 7h8M8 4l3 3-3 3"/>
              </svg>
            </a>
            <a href="#" class="inline-flex items-center gap-2 px-[22px] py-[13px] rounded-[10px] text-[14.5px] font-medium no-underline bg-transparent text-[var(--fg)] border border-[var(--line-strong)] transition-colors hover:border-[var(--fg-dim)]">Read the docs</a>
          </div>

          <div role="group" aria-label="Install command" class="install-glow relative bg-[var(--card)] border border-[var(--card-border)] rounded-[14px] pl-[18px] pr-1.5 py-1.5 flex items-center gap-3.5 font-mono text-sm max-w-[480px] backdrop-blur-md transition-colors hover:border-[var(--line-strong)]">
            <span class="text-[var(--fg-mute)] select-none">$</span>
            <span class="text-[var(--fg)] flex-1"><span class="text-[var(--accent)]">corepack</span> enable &amp;&amp; <span class="text-[var(--accent)]">yarn</span> init -2</span>
            <button id="copy-btn" aria-label="Copy install command" class="bg-transparent text-[var(--fg-dim)] border border-[var(--line)] rounded-lg px-3 py-2 font-[inherit] text-xs cursor-pointer inline-flex items-center gap-1.5 transition-all hover:text-[var(--fg)] hover:border-[var(--line-strong)]">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <path d="M2 8V2h6" opacity="0.6"/>
              </svg>
              <span id="copy-label">Copy</span>
            </button>
          </div>
        </div>

        <div class="relative aspect-square w-full max-w-[520px] md:justify-self-end">
          <div class="absolute inset-0 border border-[var(--line)] rounded-full pointer-events-none"></div>
          <div class="absolute -inset-10 border border-[var(--line)] rounded-full pointer-events-none opacity-50"></div>
          <div class="absolute -inset-20 border border-[var(--line)] rounded-full pointer-events-none opacity-25"></div>
          <img class="cat w-full h-full block object-contain" id="cat-img" src="cat.png" alt="" aria-hidden="true" crossorigin="anonymous" />
          <div id="tip-card" aria-live="polite" class="absolute -bottom-6 -right-3 w-80 max-w-full px-[18px] py-3.5 bg-[var(--card)] border border-[var(--card-border)] rounded-xl backdrop-blur-xl backdrop-saturate-150 shadow-[0_10px_40px_-20px_rgba(0,0,0,0.6)] z-[2] font-sans">
            <div class="flex items-center justify-between gap-3 mb-1.5">
              <span class="mono text-[10.5px] tracking-[0.1em] text-[var(--fg-mute)] uppercase whitespace-nowrap">// did you know</span>
              <span class="mono text-[10.5px] text-[var(--fg-mute)] tabular-nums" id="tip-count">01 / 06</span>
            </div>
            <p id="tip-body" class="text-[13px] leading-[1.5] text-[var(--fg-dim)] text-pretty min-h-[3.9em] m-0 mb-2.5"></p>
            <div class="flex items-center gap-1 justify-end">
              <div class="inline-flex gap-1 px-2" id="tip-dots"></div>
              <button id="tip-prev" aria-label="Previous tip" class="w-[26px] h-[26px] border border-[var(--line)] rounded-md bg-transparent text-[var(--fg-dim)] cursor-pointer inline-flex items-center justify-center transition-all p-0 hover:text-[var(--fg)] hover:border-[var(--line-strong)] active:scale-95">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6.5 2L3 5l3.5 3"/></svg>
              </button>
              <button id="tip-next" aria-label="Next tip" class="w-[26px] h-[26px] border border-[var(--line)] rounded-md bg-transparent text-[var(--fg-dim)] cursor-pointer inline-flex items-center justify-center transition-all p-0 hover:text-[var(--fg)] hover:border-[var(--line-strong)] active:scale-95">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 2L7 5l-3.5 3"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="relative py-[120px] px-8 border-t border-[var(--line)] bg-[color-mix(in_oklch,var(--bg-0)_75%,transparent)] backdrop-blur-[2px]">
    <div class="max-w-[1240px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-4 md:gap-[60px] mb-[72px]">
        <div>
          <div class="mono text-xs text-[var(--fg-mute)] tracking-[0.1em]">§ 01 — PRINCIPLES</div>
          <h2 class="text-[clamp(32px,4vw,52px)] font-medium leading-[1.05] tracking-[-0.025em] mt-3 mb-0 text-balance">Built on four<br/>non-negotiables.</h2>
        </div>
        <p class="text-base text-[var(--fg-dim)] leading-[1.55] max-w-[560px] text-pretty">Every decision in Yarn is measured against determinism, speed, ergonomics, and monorepo-scale ergonomics. No magic. No surprises in CI.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 border-t border-l border-[var(--line)]">
        <div class="p-8 pt-9 pb-10 border-r border-b border-[var(--line)] relative">
          <div class="w-9 h-9 border border-[var(--line-strong)] rounded-lg inline-flex items-center justify-center text-[var(--accent)] mb-[22px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="12" height="12" rx="1"/><path d="M3 7h12M7 3v12"/></svg>
          </div>
          <div class="mono text-[11px] text-[var(--fg-mute)] tracking-[0.08em]">01</div>
          <h3 class="text-[20px] font-medium tracking-[-0.01em] mt-3.5 mb-2.5">Deterministic by default</h3>
          <p class="text-[14.5px] leading-[1.55] text-[var(--fg-dim)] m-0 text-pretty">A single <span class="mono">yarn.lock</span> produces byte-identical <span class="mono">node_modules</span> across machines, OSes, and CI providers. If it installs for you, it installs for them.</p>
        </div>
        <div class="p-8 pt-9 pb-10 border-r border-b border-[var(--line)] relative">
          <div class="w-9 h-9 border border-[var(--line-strong)] rounded-lg inline-flex items-center justify-center text-[var(--accent)] mb-[22px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 2v14M2 9h14" opacity="0.5"/><path d="M4 4l10 10M14 4L4 14"/></svg>
          </div>
          <div class="mono text-[11px] text-[var(--fg-mute)] tracking-[0.08em]">02</div>
          <h3 class="text-[20px] font-medium tracking-[-0.01em] mt-3.5 mb-2.5">Plug'n'Play resolution</h3>
          <p class="text-[14.5px] leading-[1.55] text-[var(--fg-dim)] m-0 text-pretty">Skip <span class="mono">node_modules</span> entirely. PnP maps imports directly to the content-addressable cache — a single install instead of thousands of file copies.</p>
        </div>
        <div class="p-8 pt-9 pb-10 border-r border-b border-[var(--line)] relative">
          <div class="w-9 h-9 border border-[var(--line-strong)] rounded-lg inline-flex items-center justify-center text-[var(--accent)] mb-[22px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="9" cy="9" r="6"/><path d="M9 5v4l3 2"/></svg>
          </div>
          <div class="mono text-[11px] text-[var(--fg-mute)] tracking-[0.08em]">03</div>
          <h3 class="text-[20px] font-medium tracking-[-0.01em] mt-3.5 mb-2.5">Offline-first cache</h3>
          <p class="text-[14.5px] leading-[1.55] text-[var(--fg-dim)] m-0 text-pretty">Every package you've ever resolved lives in the global cache. Subsequent installs — even in fresh clones — hit the registry zero times.</p>
        </div>
        <div class="p-8 pt-9 pb-10 border-r border-b border-[var(--line)] relative">
          <div class="w-9 h-9 border border-[var(--line-strong)] rounded-lg inline-flex items-center justify-center text-[var(--accent)] mb-[22px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="5" height="5"/><rect x="10" y="3" width="5" height="5"/><rect x="3" y="10" width="5" height="5"/><rect x="10" y="10" width="5" height="5"/></svg>
          </div>
          <div class="mono text-[11px] text-[var(--fg-mute)] tracking-[0.08em]">04</div>
          <h3 class="text-[20px] font-medium tracking-[-0.01em] mt-3.5 mb-2.5">Workspaces, first-class</h3>
          <p class="text-[14.5px] leading-[1.55] text-[var(--fg-dim)] m-0 text-pretty">Monorepo primitives are native, not bolted on. Topological builds, shared ranges, and constraint-based version policies across hundreds of packages.</p>
        </div>
        <div class="p-8 pt-9 pb-10 border-r border-b border-[var(--line)] relative">
          <div class="w-9 h-9 border border-[var(--line-strong)] rounded-lg inline-flex items-center justify-center text-[var(--accent)] mb-[22px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 14l5-8 3 5 2-3 4 6"/><path d="M2 14h14" opacity="0.5"/></svg>
          </div>
          <div class="mono text-[11px] text-[var(--fg-mute)] tracking-[0.08em]">05</div>
          <h3 class="text-[20px] font-medium tracking-[-0.01em] mt-3.5 mb-2.5">Parallel everything</h3>
          <p class="text-[14.5px] leading-[1.55] text-[var(--fg-dim)] m-0 text-pretty">Fetch, link, and build stages run concurrently with bounded worker pools. <span class="mono">yarn install</span> saturates your CPU, not your patience.</p>
        </div>
        <div class="p-8 pt-9 pb-10 border-r border-b border-[var(--line)] relative">
          <div class="w-9 h-9 border border-[var(--line-strong)] rounded-lg inline-flex items-center justify-center text-[var(--accent)] mb-[22px]">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="4" width="12" height="10" rx="1"/><path d="M6 8h6M6 11h4"/></svg>
          </div>
          <div class="mono text-[11px] text-[var(--fg-mute)] tracking-[0.08em]">06</div>
          <h3 class="text-[20px] font-medium tracking-[-0.01em] mt-3.5 mb-2.5">Constraints engine</h3>
          <p class="text-[14.5px] leading-[1.55] text-[var(--fg-dim)] m-0 text-pretty">Enforce version policy declaratively across a monorepo. Prolog-style rules catch drift before it lands in <span class="mono">main</span>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance -->
  <section id="performance" class="relative py-[120px] px-8 border-t border-[var(--line)] bg-[color-mix(in_oklch,var(--bg-0)_75%,transparent)] backdrop-blur-[2px]">
    <div class="max-w-[1240px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-4 md:gap-[60px] mb-[72px]">
        <div>
          <div class="mono text-xs text-[var(--fg-mute)] tracking-[0.1em]">§ 02 — BENCHMARKS</div>
          <h2 class="text-[clamp(32px,4vw,52px)] font-medium leading-[1.05] tracking-[-0.025em] mt-3 mb-0 text-balance">Cold install,<br/>10k-dependency graph.</h2>
        </div>
        <p class="text-base text-[var(--fg-dim)] leading-[1.55] max-w-[560px] text-pretty">Median of 50 runs on a 4-core CI runner with a warm network but empty cache. Lower is better. Your mileage will vary; ours doesn't, much.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-10 md:gap-20 items-center">
        <div class="text-sm text-[var(--fg-dim)] leading-[1.6]">
          <div class="mb-3.5">
            <span class="inline-flex items-center gap-2 mr-5 mono text-xs text-[var(--fg)]"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--accent)]"></span>yarn 4.8</span>
            <span class="inline-flex items-center gap-2 mr-5 mono text-xs text-[var(--fg)]"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--fg-dim)]"></span>others</span>
          </div>
          <p>Measurements captured with <span class="mono">hyperfine</span> against a fixture monorepo (<span class="mono">10,204</span> direct &amp; transitive deps, <span class="mono">1.2GB</span> resolved). PnP mode enabled for Yarn; strict peer deps enforced for all.</p>
          <p class="text-xs text-[var(--fg-mute)] mono mt-8 pt-5 border-t border-[var(--line)]">// methodology: github.com/yarnpkg/bench — commit a91f4c2</p>
        </div>

        <div id="chart" class="flex flex-col gap-5"></div>
      </div>
    </div>
  </section>

  <!-- Ecosystem -->
  <section id="ecosystem" class="relative py-[120px] px-8 border-t border-[var(--line)] bg-[color-mix(in_oklch,var(--bg-0)_75%,transparent)] backdrop-blur-[2px]">
    <div class="max-w-[1240px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-4 md:gap-[60px] mb-[72px]">
        <div>
          <div class="mono text-xs text-[var(--fg-mute)] tracking-[0.1em]">§ 03 — ADOPTION</div>
          <h2 class="text-[clamp(32px,4vw,52px)] font-medium leading-[1.05] tracking-[-0.025em] mt-3 mb-0 text-balance">Trusted in production,<br/>at scale.</h2>
        </div>
        <p class="text-base text-[var(--fg-dim)] leading-[1.55] max-w-[560px] text-pretty">Yarn powers monorepos at companies you've heard of. Names anonymized because marketing logos feel cheap on a tool that ships lockfiles.</p>
      </div>
      <div class="flex flex-wrap gap-x-16 gap-y-12 items-center justify-center py-5 opacity-80">
        <div class="text-[22px] font-medium tracking-[-0.02em] text-[var(--fg-dim)] flex items-center gap-2.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--fg-mute)] opacity-60"></span>fintech co.</div>
        <div class="text-[22px] font-medium tracking-[-0.02em] text-[var(--fg-dim)] flex items-center gap-2.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--fg-mute)] opacity-60"></span>social network</div>
