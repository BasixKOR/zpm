---
interface Props {
  title?: string;
  id?: string;
  animated?: boolean;
}

const { title, id, animated = false } = Astro.props;
---

<div class="slide-terminal relative bg-[var(--term-bg)] border border-[var(--code-border)] rounded-[14px] overflow-hidden backdrop-blur-[8px] font-mono shadow-[0_30px_80px_-40px_rgba(0,0,0,0.6)]" data-anim={animated || undefined}>
  <div class="flex items-center gap-3 py-3 px-4.5 border-b border-[var(--code-border)] text-[13px] text-[var(--fg-mute)]">
    <span class="inline-flex gap-1.5">
      <span class="slide-terminal-dot size-2.5 rounded-full bg-[var(--line-strong)]"></span>
      <span class="slide-terminal-dot size-2.5 rounded-full bg-[var(--line-strong)]"></span>
      <span class="slide-terminal-dot size-2.5 rounded-full bg-[var(--line-strong)]"></span>
    </span>
    {title && <span class="text-[13px] text-[var(--fg-dim)]">{title}</span>}
  </div>
  <div class="slide-terminal-body pt-6 px-7 pb-7 text-[19px] leading-[1.55] text-[var(--term-out)] min-h-[200px]" id={id}>
    <slot />
  </div>
</div>
