---
import ContentSlide from '../ContentSlide.astro';
import ImageFrame from '../ImageFrame.astro';

interface Props {
  eyebrow: string;
  title: string;
  titleSize?: string;
  sectionTag: string;
  bottomLeft?: string;
  bottomRight?: string;
  label?: string;
  placeholder?: string;
  caption?: string;
}

const { eyebrow, title, titleSize = '60px', sectionTag, bottomLeft, bottomRight, label, placeholder, caption } = Astro.props;
---

<ContentSlide sectionTag={sectionTag} bottomLeft={bottomLeft} bottomRight={bottomRight} label={label}>
  <div class="reveal reveal-1 font-mono text-sm tracking-[0.14em] text-[var(--fg-mute)] uppercase mb-7">{eyebrow}</div>
  <h2 class="slide-title reveal reveal-2 leading-[1.02] tracking-[-0.028em] font-medium m-0 mb-9 text-balance" style={`font-size: ${titleSize}`} set:html={title} />

  <div class="reveal reveal-3 flex-1 min-h-0 max-h-[620px]">
    <ImageFrame placeholder={placeholder} caption={caption} style="height: 100%" />
  </div>
</ContentSlide>
