---
import SlideChrome from './SlideChrome.astro';

interface Props {
  tag?: string;
  label?: string;
}

const { tag = `// internal`, label = `01 Title` } = Astro.props;
---

<section class="slide relative w-[1920px] h-[1080px] overflow-hidden text-[var(--fg)] font-['Space_Grotesk',system-ui,sans-serif] bg-transparent!" data-screen-label={label}>
  <SlideChrome tag={tag} revealBrand={true} />

  <div class="relative z-2 px-[140px] h-full flex flex-col justify-center">
    <slot />
  </div>

  <div class="absolute inset-[auto_88px_56px] z-3 pointer-events-none flex justify-between items-end font-mono text-xs text-[var(--fg-mute)]">
    <slot name="bottom-left">
      <span class="reveal reveal-5">&rarr; press space to continue</span>
    </slot>
    <slot name="bottom-right" />
  </div>
</section>
